# Neon PostgreSQL pooled connection string used by the deployed Next.js app.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
HRMS_AUTH_ENABLED="false"

# ai-nonymauz-cloud. The deployed Render URL is also the code default.
# API key is optional because the current deployment does not require one.
AI_NONYMAUZ_BASE_URL="https://ai-nonymauz-cloud.onrender.com"
AI_NONYMAUZ_API_KEY=""
# Leave empty to let ai-nonymauz-cloud route by fast / normal / deep mode.
AI_NONYMAUZ_MODEL=""

# Web push, for the employee HR app at /hr/app. Leave blank to disable: the
# in-app bell and Inbox work regardless, and the "Turn on notifications" card
# hides itself rather than offering a button that cannot work.
#
# Generate a pair with:  npx web-push generate-vapid-keys
# The public key is served to browsers by design. The private key must not be.
# VAPID_SUBJECT identifies the sender to the push services and must be a
# mailto: or https: URL.
#
# On iPhone and iPad these only take effect for an app added to the home
# screen — Apple does not deliver push to a Safari tab.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hr@kretivco.com"

# LHDN MyInvois e-Invoice. Leave blank to disable submission entirely; the
# accounting workspace still works and simply reports e-Invoice as unconfigured.
# Credentials are issued by LHDN against a registered TIN.
MYINVOIS_ENVIRONMENT="sandbox"
MYINVOIS_CLIENT_ID=""
MYINVOIS_CLIENT_SECRET=""
MYINVOIS_SUPPLIER_TIN=""
MYINVOIS_SUPPLIER_BRN=""
# Only when submitting on behalf of another taxpayer as an intermediary.
MYINVOIS_ON_BEHALF_OF=""
