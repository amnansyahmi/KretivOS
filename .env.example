# Neon PostgreSQL pooled connection string used by the deployed Next.js app.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
HRMS_AUTH_ENABLED="false"

# ai-nonymauz-cloud. The deployed Render URL is also the code default.
# API key is optional because the current deployment does not require one.
AI_NONYMAUZ_BASE_URL="https://ai-nonymauz-cloud.onrender.com"
AI_NONYMAUZ_API_KEY=""
# Leave empty to let ai-nonymauz-cloud route by fast / normal / deep mode.
AI_NONYMAUZ_MODEL=""
